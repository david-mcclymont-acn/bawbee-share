# Copy to .env on the home VM. Never commit .env.

# Where docker compose publishes the app. nginx proxies HTTPS to this.
BAWBEE_BIND=127.0.0.1
BAWBEE_PORT=8000

# App settings (BAWBEE_* are read by backend/app/config.py)
BAWBEE_LOG_LEVEL=INFO
# BAWBEE_DATABASE_URL=sqlite:////data/bawbee.db

# The HTTPS address you open the app on (used for the OIDC redirect).
BAWBEE_PUBLIC_URL=https://bawbee.<my-domain>

# Login. Local accounts are the default; create them on the host with
#   docker compose exec bawbee-app bawbee user create person_1 --person person_1
# Session cookies are HTTPS-only. Set false only for plain-HTTP testing on a LAN.
# BAWBEE_COOKIE_SECURE=true
# BAWBEE_SESSION_DAYS=30
# BAWBEE_AUTH_LOCAL=true
# Optional OIDC (e.g. authentik). Leave unset to use local accounts only.
# Redirect URI to register at the provider: https://bawbee.<my-domain>/api/auth/oidc/callback
# BAWBEE_OIDC_ISSUER=https://auth.<my-domain>/application/o/bawbee/
# BAWBEE_OIDC_CLIENT_ID=
# BAWBEE_OIDC_CLIENT_SECRET=
# BAWBEE_OIDC_LABEL=authentik

# Banks (docs/providers.md). Secrets live in ./secrets on the host (gitignored), mounted
# read-only at /run/bawbee-secrets. Make the key with: docker compose run --rm bawbee-app bawbee fernet-key
BAWBEE_FERNET_KEY_FILE=/run/bawbee-secrets/fernet.key
# Enable Banking (RBS): the application id from its control panel, and its private key.
# Register the redirect URL https://bawbee.<my-domain>/api/banks/callback there.
# BAWBEE_ENABLE_BANKING_APP_ID=
# BAWBEE_ENABLE_BANKING_KEY_FILE=/run/bawbee-secrets/enable_banking.pem
# Monzo Developer API (Person 1 Monzo): a confidential client from developers.monzo.com, with
# the same redirect URL. The secret goes in a file, like the key above.
# BAWBEE_MONZO_CLIENT_ID=
# BAWBEE_MONZO_CLIENT_SECRET_FILE=/run/bawbee-secrets/monzo_client_secret
# Syncs (UK time) and how often "Sync now" may run per link.
# BAWBEE_SYNC_HOURS=6,18
# BAWBEE_MANUAL_SYNC_MINUTES=30
# The fake Demo Bank: Codespaces and CI only, never on the home VM.
# BAWBEE_BANKS_DEMO=false

# Home Assistant (docs/home-assistant.md): notifications go to this webhook. Its id is the
# secret, so keep it long and random.
# BAWBEE_HA_WEBHOOK_URL=http://homeassistant.lan:8123/api/webhook/<long-random-id>
# Warn when Joint Billing is projected below this (pence) before the next payday.
# BAWBEE_HA_LOW_BALANCE_PENCE=5000
